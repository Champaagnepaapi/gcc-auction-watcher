# eBay Browse API officielle (aucun credential dans le code)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_V5_ENVIRONMENT=production
EBAY_V5_MARKETPLACE_ID=EBAY_FR
EBAY_V5_CATEGORY_ID=
EBAY_V5_RAW_ASPECT_NAME=Graded
EBAY_V5_RAW_ASPECT_VALUE=No
EBAY_V5_DELIVERY_COUNTRY=FR
EBAY_V5_DELIVERY_POSTAL_CODE=
EBAY_V5_CONTENT_LANGUAGE=fr-FR
EBAY_V5_TIMEOUT_SECONDS=15

# Fourchette RAW V5 uniquement. Aucun lien avec MIN_PRICE_EUR de V4.
RAW_MIN_PRICE_EUR=0
RAW_MAX_PRICE_EUR=

# Cheap filter: PSA10 est le plafond plausible avant toute analyse visuelle.
RAW_MIN_PLAUSIBLE_PROFIT_EUR=0
RAW_MIN_PLAUSIBLE_ROI_PERCENT=0

# 0 desactive tout grading payant. A augmenter seulement apres autorisation.
RAW_MAX_PAID_GRADINGS_PER_RUN=0

# CardGrader.AI. Le POST payant reste bloque tant que cette valeur est false.
CARDGRADER_API_KEY=
CARDGRADER_V5_ALLOW_PAID_CALLS=false
CARDGRADER_V5_TIMEOUT_SECONDS=20
CARDGRADER_V5_POLL_INTERVAL_SECONDS=2
CARDGRADER_V5_MAX_WAIT_SECONDS=150

# Tous les couts doivent etre explicitement renseignes, y compris les zeros.
V5_BUYER_FEES=
V5_GRADING_FEE=
V5_GRADING_SHIPPING=
V5_SELLING_FEE_RATE=
V5_OTHER_COSTS=

# Garde-fous et probabilites prudentes
V5_MIN_PSA_SAMPLES=2
V5_MIN_ROI_PERCENT=0
V5_MAX_PSA10_EV_SHARE=0.65
V5_MIN_GRADE_CONFIDENCE=
# Exemple JSON: {"10":[0.30,0.45,0.18,0.07],"9":[0.06,0.49,0.30,0.15],"8":[0.01,0.14,0.50,0.35],"lower":[0.00,0.04,0.21,0.75]}
V5_GRADE_DISTRIBUTIONS_JSON=
